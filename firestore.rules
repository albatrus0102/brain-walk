rules_version = '2';

// =============================================================================
//  오늘의 두뇌 산책 (brain-walk) — Firestore security rules
//
//  Identity model (see ARCHITECTURE.md §5):
//    * request.auth.uid  = one Firebase Auth user = one DEVICE/browser profile
//                          (anonymous, optionally linked to Google).
//    * memberId          = one PERSON in one family. A person may have several
//                          uids (phone + tablet, Safari + installed PWA, new phone).
//    * families/{fid}/uids/{uid} -> { memberId }  is the ONLY thing that makes a
//      uid a member. Every family-scoped rule resolves "me" through it.
//
//  Timestamps: the app keeps client epoch-millis numbers in `ts`/`lastReadTs`
//  (existing schema). Anything security-relevant (rate limits, code expiry,
//  ordering for push) uses server timestamps (== request.time).
//
//  Roles (DESIGN.md §1, §3): owner (families.ownerMemberId) ⊂ admin
//  (owner, or listed in families.admins AND role 'family'). Admin-only: learner
//  plan/display, alarm, trainee assignment, role changes after the initial join,
//  join-code rotation, recovery codes for others, removing members, deleting
//  others' records. Owner-only: admins list, ownership, delete-all.
//
//  Access-call budget: ≤10 get/exists per single op, ≤20 per batch; the
//  heaviest ops here (nudge message create, admin role change, admin grant)
//  use at most 5 distinct documents.
// =============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------- helpers
    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }

    function famPath(fid) { return /databases/$(database)/documents/families/$(fid); }
    function linkPath(fid) { return /databases/$(database)/documents/families/$(fid)/uids/$(request.auth.uid); }
    function memberPath(fid, mid) { return /databases/$(database)/documents/families/$(fid)/members/$(mid); }
    function joinCodePath(code) { return /databases/$(database)/documents/joinCodes/$(code); }
    function transferPath(code) { return /databases/$(database)/documents/transferCodes/$(code); }

    // 훈련하는 분 목록 (DESIGN-MULTI §1.1): families/{fid}/state/trainees = { v, ids[≤4], labels{id:호칭}, updatedBy, updatedTs }
    function tsPath(fid) { return /databases/$(database)/documents/families/$(fid)/state/trainees; }

    function isMember(fid) { return signedIn() && exists(linkPath(fid)); }
    function myId(fid) { return get(linkPath(fid)).data.memberId; }
    function myMember(fid) { return get(memberPath(fid, myId(fid))).data; }
    function ownerId(fid) { return get(famPath(fid)).data.ownerMemberId; }
    function isOwner(fid) { return ownerId(fid) == myId(fid); }

    // 가족 전용 자료(설문·일상생활 체크·시계 그림·병원 검사)용: 내 member 문서의 role 이 'family' 인 사람만 읽어요.
    // 훈련하는 분(role 'trainee')은 (설문처럼) 만들 수는 있어도 읽을 수 없어요.
    // role 은 처음 가입할 때(가입 후 30분 안)를 빼면 관리자만 바꿀 수 있어요 (members 규칙). DESIGN.md §3.
    function isFamilyRole(fid) { return myMember(fid).role == 'family'; }

    // ---- 관리자 (DESIGN.md §1)
    // families/{fid}.admins : [memberId] (없으면 [] = 방 주인만 관리자. 예전 가족방은 그대로 방 주인만 관리자예요.)
    // 방 주인은 역할과 상관없이 늘 관리자. 그 밖의 사람은 admins 목록에 있고 role 이 'family' 일 때만 관리자예요
    // (관리자였던 사람을 훈련하는 분으로 지정하면 그 순간 관리자 권한이 꺼져요).
    function adminsOf(fid) { return get(famPath(fid)).data.get('admins', []); }
    function isAdmin(fid) {
      return isMember(fid) && (isOwner(fid) || (myId(fid) in adminsOf(fid) && isFamilyRole(fid)));
    }
    // 훈련하는 분 목록 T (없으면 아무도 훈련하는 분이 아니에요)
    function tIds(fid) { return exists(tsPath(fid)) ? get(tsPath(fid)).data.ids : []; }
    function inT(fid, id) { return id in tIds(fid); }
    // 내가 T 에 있나 (이름은 예전과 같아요: 쓰던 곳이 그대로 동작해요)
    function isAssignedTrainee(fid) { return inT(fid, myId(fid)); }
    // 가족 전용 자료를 읽을 수 있는 사람: role 'family' 이고 T 에 없는 사람 (M4)
    function isFamilyOnlyReader(fid) { return isFamilyRole(fid) && !isAssignedTrainee(fid); }
    // 서버가 계산한 AI 자료를 읽는 사람: 관리자이면서 가족 전용 자료를 읽을 수 있는 사람
    function isAiAdmin(fid) { return isAdmin(fid) && isFamilyOnlyReader(fid); }
    function isCurrentTrainee(fid, mid) { return inT(fid, mid); }

    // ---- 새 가족방 만들기는 '만들기 코드'를 아는 사람만 (코드 N = 대문자, 공백·줄표 없는 12글자. 앱이 보내는 증거 proof = sha256hex(N), appConfig/creation.codeHash = sha256hex(sha256hex(N)). toHexString() 은 대문자라서 .lower() 로 맞춰요).
    // appConfig 는 앱에서 읽을 수 없고, 코드 문서가 없으면 아무도 새 가족방을 못 만들어요. 이미 있는 가족방은 영향이 없어요.
    // 코드 바꾸기는 appConfig/primary.fid 가 가리키는 가족방(서버가 심어요)의 방 주인만. 생 코드는 서버에 오지 않아요 (생 코드를 proof 로 보내도 해시가 달라 거절돼요).
    function creationPath() { return /databases/$(database)/documents/appConfig/creation; }
    function primaryPath() { return /databases/$(database)/documents/appConfig/primary; }
    function proofPath(u) { return /databases/$(database)/documents/createProofs/$(u); }
    function validProofDoc(d) {
      return d.keys().hasOnly(['proof', 'ts']) && d.keys().hasAll(['proof', 'ts'])
        && d.proof is string && d.proof.matches('^[0-9a-f]{64}$')
        && exists(creationPath()) && hashing.sha256(d.proof).toHexString().lower() == get(creationPath()).data.codeHash;
    }
    function isPrimaryOwner() {
      return signedIn() && exists(primaryPath()) && isMember(get(primaryPath()).data.fid) && isOwner(get(primaryPath()).data.fid);
    }

    function newData() { return request.resource.data; }
    function oldData() { return resource.data; }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }

    function str(v, max) { return v is string && v.size() <= max; }
    function nonEmpty(v, max) { return v is string && v.size() > 0 && v.size() <= max; }
    function okId(v) { return v is string && v.matches('^[A-Za-z0-9_-]{1,64}$'); }
    // 6 chars from a 32-symbol alphabet: 2-9 and A-Z without I and O (no 0/O/1/I).
    function okCode(v) { return v is string && v.matches('^[2-9A-HJ-NP-Z]{6}$'); }
    function okDate(v) { return v is string && v.matches('^20[0-9]{2}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$'); }
    function okHHMM(v) { return v is string && v.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$'); }
    // Client epoch-millis: plausible, not more than 10 min in the future.
    // (No lower bound against request.time: offline-queued writes commit late.)
    function okMs(v) { return v is number && v > 1600000000000 && v <= request.time.toMillis() + 600000; }
    // Optional fields: absent, null, or the right type. (The adapter initialises
    // Firestore with ignoreUndefinedProperties so `undefined` is simply dropped.)
    function optStr(field, max) { return !(field in newData()) || newData()[field] == null || str(newData()[field], max); }
    function optNum(field) { return !(field in newData()) || newData()[field] == null || newData()[field] is number; }
    function optBool(field) { return !(field in newData()) || newData()[field] == null || newData()[field] is bool; }

    // ============================================================ join codes
    // joinCodes/{CODE} -> { familyId, createdBy(memberId), createdTs, expiresTs }
    // get-only: a guess either succeeds (valid, unexpired code) or is denied.
    // Non-existent and expired codes both return permission-denied, and `list`
    // is impossible, so families cannot be enumerated (see ARCHITECTURE §5.6).
    match /joinCodes/{code} {
      allow get: if signedIn() && resource.data.expiresTs > request.time;
      allow list: if false;
      allow create: if signedIn() && okCode(code)
        && newData().keys().hasOnly(['familyId', 'createdBy', 'createdTs', 'expiresTs'])
        && okId(newData().familyId)
        && newData().createdTs == request.time
        && newData().expiresTs is timestamp
        && newData().expiresTs > request.time
        && newData().expiresTs <= request.time + duration.value(15, 'd')
        // creator is (or, in the founding batch, becomes) a member of that family
        && existsAfter(/databases/$(database)/documents/families/$(newData().familyId)/uids/$(uid()))
        && newData().createdBy == getAfter(/databases/$(database)/documents/families/$(newData().familyId)/uids/$(uid())).data.memberId
        // 가족방을 만드는 배치(가족 문서가 아직 없음)이거나, 관리자만 새 코드를 만들어요.
        && (!exists(famPath(newData().familyId)) || isAdmin(newData().familyId));
      allow update: if false;
      allow delete: if signedIn() && isAdmin(resource.data.familyId);
    }

    // ======================================================= 가족방 만들기 코드
    match /appConfig/primary { allow read, write: if false; }   // 서버(Admin SDK)만 심어요: { fid }
    match /appConfig/creation {
      allow read: if false;
      allow create, update: if isPrimaryOwner()
        && newData().keys().hasOnly(['codeHash', 'setBy', 'updatedTs']) && newData().keys().hasAll(['codeHash', 'setBy', 'updatedTs'])
        && newData().codeHash is string && newData().codeHash.matches('^[0-9a-f]{64}$')
        && newData().setBy == myId(get(primaryPath()).data.fid)
        && newData().updatedTs == request.time;
      allow delete: if false;
    }
    // 만들기 코드를 입력했다는 증거: 코드가 맞을 때만 쓸 수 있고(그래서 화면에서 바로 확인돼요), 아무도 읽지 못해요. 가족방 만들기 배치가 이것을 확인해요.
    match /createProofs/{u} {
      allow read: if false;
      allow create, update: if signedIn() && u == uid() && validProofDoc(newData()) && newData().ts == request.time;
      allow delete: if signedIn() && u == uid();
    }

    // ======================================================= transfer codes
    // One-time "다른 기기로 옮기기" / family-issued recovery code.
    // transferCodes/{CODE} -> { familyId, memberId, createdBy, createdTs, expiresTs, usedBy?, usedTs? }
    match /transferCodes/{code} {
      allow get: if signedIn()
        && resource.data.expiresTs > request.time
        && !('usedBy' in resource.data);
      allow list: if false;
      allow create: if signedIn() && okCode(code)
        && newData().keys().hasOnly(['familyId', 'memberId', 'createdBy', 'createdTs', 'expiresTs'])
        && okId(newData().familyId) && okId(newData().memberId)
        && isMember(newData().familyId)
        && newData().createdBy == myId(newData().familyId)
        && exists(memberPath(newData().familyId, newData().memberId))
        // 떠난(내보낸) 사람에게는 코드를 만들 수 없어요
        && !('leftTs' in get(memberPath(newData().familyId, newData().memberId)).data)
        // 다른 사람의 복구 코드: 관리자만 (방 주인 포함). 내 코드(다른 기기로 옮기기)는 누구나.
        // (방금 가족 코드로 들어온 사람이 곧바로 아버지·방 주인으로 옮겨 타는 것을 막아요)
        && (newData().memberId == myId(newData().familyId) || isAdmin(newData().familyId))
        && newData().createdTs == request.time
        && newData().expiresTs is timestamp
        && newData().expiresTs > request.time
        && newData().expiresTs <= request.time + duration.value(30, 'm');
      // Redeem: mark used by me, atomically with creating my uid link (checked
      // from the other side in families/{fid}/uids/{uid}).
      allow update: if signedIn()
        && changed().hasOnly(['usedBy', 'usedTs'])
        && !('usedBy' in resource.data)
        && resource.data.expiresTs > request.time
        && newData().usedBy == uid()
        && newData().usedTs == request.time
        && getAfter(/databases/$(database)/documents/families/$(resource.data.familyId)/uids/$(uid())).data.memberId == resource.data.memberId;
      allow delete: if signedIn() && isMember(resource.data.familyId)
        && (resource.data.createdBy == myId(resource.data.familyId) || isAdmin(resource.data.familyId));
    }

    // ================================================================ users
    // users/{uid} -> { familyId, memberId, updatedAt } : "which family is this
    // device in" pointer, used after Google sign-in on a new device. It grants
    // nothing by itself; membership is always checked via families/{fid}/uids.
    match /users/{u} {
      allow read, delete: if signedIn() && u == uid();
      allow create, update: if signedIn() && u == uid()
        && newData().keys().hasOnly(['familyId', 'memberId', 'updatedAt'])
        && okId(newData().familyId) && okId(newData().memberId)
        && newData().updatedAt == request.time;
    }

    // ============================================================= families
    match /families/{fid} {

      // ---- founding / joining / transferring (used by uids/{uid} create)
      function founding() {
        return newData().via == 'create'
          && !exists(famPath(fid))
          && getAfter(famPath(fid)).data.createdBy == uid()
          && getAfter(famPath(fid)).data.ownerMemberId == newData().memberId;
      }
      function joining() {
        return newData().via == 'join'
          && okCode(newData().code)
          && get(joinCodePath(newData().code)).data.familyId == fid
          && get(joinCodePath(newData().code)).data.expiresTs > request.time
          // a join ALWAYS creates a brand-new person; it can never attach to
          // an existing member (that would be impersonation)
          && !exists(memberPath(fid, newData().memberId))
          && existsAfter(memberPath(fid, newData().memberId));
      }
      function transferring() {
        return newData().via == 'transfer'
          && okCode(newData().code)
          && get(transferPath(newData().code)).data.familyId == fid
          && get(transferPath(newData().code)).data.memberId == newData().memberId
          && get(transferPath(newData().code)).data.expiresTs > request.time
          && !('usedBy' in get(transferPath(newData().code)).data)
          && getAfter(transferPath(newData().code)).data.usedBy == uid()
          && exists(memberPath(fid, newData().memberId))
          // 내보내진(또는 떠난) 사람은 미리 만들어 둔 코드로도 다시 들어올 수 없어요
          && !('leftTs' in get(memberPath(fid, newData().memberId)).data);
      }

      // ---- family root doc
      // { createdBy(uid), createdTs, ownerMemberId, joinCode, name?, schemaVersion?, admins?[memberId] }
      // admins 바꾸기(방 주인만): 한 번에 한 명을 끝에 더하거나(그 사람은 '가족' 역할이고 떠나지 않은 사람), 아무나 빼기.
      // (목록 자르기 after[0:n] 은 n=0 일 때 에뮬레이터에서 오류가 나서, 집합으로 확인해요: 중복 없음 + 예전 사람 모두 포함 + 마지막이 새 사람)
      function validAdminsChange() {
        let before = oldData().get('admins', []);
        let after = newData().admins;
        return after is list && after.size() <= 10 && after.toSet().size() == after.size()
          && ((after.size() < before.size() && before.hasAll(after))
              || (after.size() == before.size() + 1
                  && after.hasAll(before)
                  && !(after[after.size() - 1] in before)
                  && grantable(after[after.size() - 1])));
      }
      function grantable(m) {
        return m is string && exists(memberPath(fid, m))
          && get(memberPath(fid, m)).data.role == 'family'
          && !('leftTs' in get(memberPath(fid, m)).data);
      }
      allow get: if isMember(fid);
      allow list: if false;
      allow create: if signedIn()
        && newData().keys().hasOnly(['createdBy', 'createdTs', 'ownerMemberId', 'joinCode', 'name', 'schemaVersion'])
        && newData().createdBy == uid()
        && newData().createdTs == request.time
        && okId(newData().ownerMemberId)
        && okCode(newData().joinCode)
        && optStr('name', 30)
        && optNum('schemaVersion')
        && getAfter(linkPath(fid)).data.memberId == newData().ownerMemberId
        && getAfter(joinCodePath(newData().joinCode)).data.familyId == fid
        // 만들기 코드: 30분 안에 맞는 코드를 입력한 증거가 있어야 해요 (코드가 그 뒤에 바뀌었으면 다시 입력)
        && existsAfter(proofPath(uid())) && getAfter(proofPath(uid())).data.ts > request.time - duration.value(30, 'm')
        && validProofDoc(getAfter(proofPath(uid())).data);
      allow update: if isMember(fid) && (
           (changed().hasOnly(['name']) && str(newData().name, 30) && isAdmin(fid))
        || (changed().hasOnly(['joinCode']) && okCode(newData().joinCode) && isAdmin(fid)
              && getAfter(joinCodePath(newData().joinCode)).data.familyId == fid)
        // 방 주인만: 방 주인 넘기기, 관리자 지정/해제 (함께 바꿔도 돼요: 넘기면서 나를 관리자로 남기기)
        || (isOwner(fid) && changed().hasOnly(['ownerMemberId', 'admins'])
              // 새 방 주인은 지금 있는 사람이어야 해요 (떠난 사람에게 넘기면 방 주인이 없는 방이 돼요)
              && (!('ownerMemberId' in changed()) || (exists(memberPath(fid, newData().ownerMemberId))
                    && !('leftTs' in get(memberPath(fid, newData().ownerMemberId)).data)))
              && (!('admins' in changed()) || validAdminsChange()))
      );
      allow delete: if isMember(fid) && isOwner(fid);

      // ---- uid -> member links (devices of a person)
      // { memberId, via: 'create'|'join'|'transfer', code?, addedTs, device? }
      match /uids/{u} {
        allow read: if isMember(fid);
        allow create: if signedIn() && u == uid()
          && newData().keys().hasOnly(['memberId', 'via', 'code', 'addedTs', 'device'])
          && okId(newData().memberId)
          && newData().addedTs == request.time
          && optStr('device', 40)
          && (founding() || joining() || transferring());
        allow update: if false;
        // sign out this device / revoke one of my devices / admin removes someone (never the owner)
        allow delete: if signedIn() && (
             u == uid()
          || (isMember(fid) && (resource.data.memberId == myId(fid)
                                || (isAdmin(fid) && resource.data.memberId != ownerId(fid))))
        );
      }

      // ---- members (people)
      // { name, role: 'trainee'|'family', joinedTs, nudgeAt?{traineeId: serverTs}, leftTs? }
      // T 에 있는 사람은 'family' 로 바꿀 수 없어요 (같은 배치에서 T 에서 빼면 돼요)
      function roleOkAfter(m) {
        return newData().role == 'trainee' || !existsAfter(tsPath(fid)) || !(m in getAfter(tsPath(fid)).data.ids);
      }
      // 훈련 알림 도장: 받는 사람(T)마다 따로 115분
      function okNudgeKey(ids, i) {
        let o = oldData().get('nudgeAt', {});
        let n = newData().get('nudgeAt', {});
        return ids.size() <= i || !(ids[i] in n.diff(o).affectedKeys())
          || (n[ids[i]] == request.time && o.get(ids[i], timestamp.value(0)) < request.time - duration.value(115, 'm'));
      }
      function okNudgeAt() {
        let ids = tIds(fid);
        return newData().nudgeAt is map
          && newData().nudgeAt.diff(oldData().get('nudgeAt', {})).affectedKeys().hasOnly(ids)
          && okNudgeKey(ids, 0) && okNudgeKey(ids, 1) && okNudgeKey(ids, 2) && okNudgeKey(ids, 3);
      }
      match /members/{mid} {
        allow read: if isMember(fid);
        // only in the same batch that creates my first link to this family
        allow create: if signedIn()
          && !exists(linkPath(fid))
          && getAfter(linkPath(fid)).data.memberId == mid
          && okId(mid)
          && newData().keys().hasOnly(['name', 'role', 'joinedTs'])
          && nonEmpty(newData().name, 20)
          && newData().role in ['trainee', 'family']
          && newData().joinedTs == request.time;
        allow update: if isMember(fid) && (
            // myself: name, nudge stamps, leaving. (role is NOT here: see below)
            (mid == myId(fid)
              && changed().hasOnly(['name', 'nudgeAt', 'leftTs'])
              && nonEmpty(newData().name, 20)
              // nudge rate limit per target: nudgeAt.{t} can only move to "now", and only if
              // the previous nudge to t is ≥115 min old (app enforces 2 h on its side)
              && (!('nudgeAt' in changed()) || okNudgeAt())
              && (!('leftTs' in changed()) || newData().leftTs == request.time))
            // myself, role, only during the initial join (≤30 min after joining), never to 'family' while in T
         || (mid == myId(fid)
              && changed().hasOnly(['role'])
              && newData().role in ['trainee', 'family']
              && oldData().joinedTs > request.time - duration.value(30, 'm')
              && roleOkAfter(mid))
            // admin changes anyone's role (including their own), never to 'family' while in T
         || (isAdmin(fid)
              && changed().hasOnly(['role'])
              && newData().role in ['trainee', 'family']
              && roleOkAfter(mid))
            // admin removes someone else (never the owner)
         || (mid != myId(fid) && isAdmin(fid) && mid != ownerId(fid)
              && changed().hasOnly(['leftTs'])
              && newData().leftTs == request.time)
        );
        allow delete: if isMember(fid) && isOwner(fid);

        // ---- push devices of a member (private to that member)
        // { token, uid, platform, standalone, updatedAt }
        match /devices/{did} {
          allow read, delete: if isMember(fid) && (mid == myId(fid) || isOwner(fid));
          allow create, update: if isMember(fid) && mid == myId(fid) && okId(did)
            && newData().keys().hasOnly(['token', 'uid', 'platform', 'standalone', 'updatedAt'])
            && newData().token is string
            && newData().token.size() > 20 && newData().token.size() <= 4096
            && newData().uid == uid()
            && newData().platform in ['ios', 'android', 'desktop', 'other']
            && newData().standalone is bool
            && newData().updatedAt == request.time;
        }
      }

      // ---- chat
      // { authorId, text, ts(ms), sts(server), kind, push, replyTo?, record?,
      //   reactions?{memberId:[emoji]}, acks?{memberId:ms}, deleted?, editedTs?,
      //   toId?(nudge), expireAt? }
      function validNudge() {
        return newData().toId is string
          && inT(fid, newData().toId)
          && newData().toId != myId(fid)
          // the same batch must stamp my member doc nudgeAt.{toId} (which enforces the 115-min gap per target)
          && getAfter(memberPath(fid, myId(fid))).data.get('nudgeAt', {}).get(newData().toId, null) == request.time;
      }
      function validNewMessage() {
        return newData().keys().hasOnly(['authorId', 'text', 'ts', 'sts', 'kind', 'push', 'replyTo', 'record',
                                         'reactions', 'acks', 'deleted', 'toId', 'expireAt'])
          && newData().keys().hasAll(['authorId', 'text', 'ts', 'sts', 'kind', 'push'])
          && newData().authorId == myId(fid)
          && str(newData().text, 500)
          && okMs(newData().ts)
          && newData().sts == request.time
          && newData().kind in ['text', 'record', 'summary', 'system', 'nudge']
          && newData().push in ['pending', 'none']
          && (!('replyTo' in newData()) || okId(newData().replyTo))
          && (!('record' in newData()) || (newData().record is map && newData().record.size() <= 20))
          && (!('reactions' in newData()) || (newData().reactions is map && newData().reactions.size() == 0))
          && (!('acks' in newData()) || (newData().acks is map && newData().acks.size() == 0))
          && (!('deleted' in newData()) || newData().deleted == false)
          && (!('expireAt' in newData()) || (newData().expireAt is timestamp
                && newData().expireAt > request.time
                && newData().expireAt < request.time + duration.value(800, 'd')))
          && ((newData().kind == 'nudge' && validNudge())
              || (newData().kind != 'nudge' && !('toId' in newData())));
      }
      // Each member may change only their own key inside reactions/acks.
      function onlyMine(field) {
        return newData().get(field, {}) is map
          && newData().get(field, {}).diff(oldData().get(field, {})).affectedKeys().hasOnly([myId(fid)])
          && (!(myId(fid) in newData().get(field, {}))
              || (field == 'reactions' && newData()[field][myId(fid)] is list && newData()[field][myId(fid)].size() <= 6)
              || (field == 'acks' && newData()[field][myId(fid)] is number));
      }
      function validMessageUpdate() {
        return (
            changed().hasOnly(['reactions', 'acks'])
            || (oldData().authorId == myId(fid)
                && changed().hasOnly(['text', 'deleted', 'editedTs', 'reactions', 'acks']))
          )
          && (!('text' in changed()) || str(newData().text, 500))
          && (!('deleted' in changed()) || (newData().deleted == true && newData().text == ''))
          && (!('editedTs' in changed()) || okMs(newData().editedTs))
          && (!('reactions' in changed()) || onlyMine('reactions'))
          && (!('acks' in changed()) || onlyMine('acks'));
      }
      match /messages/{msgId} {
        allow read: if isMember(fid);
        allow create: if isMember(fid) && okId(msgId) && validNewMessage();
        allow update: if isMember(fid) && validMessageUpdate();
        allow delete: if isMember(fid) && (resource.data.authorId == myId(fid) || isAdmin(fid));
      }

      // ---- training records (authored by the person who trained)
      function validSession() {
        return newData().size() <= 30
          && newData().userId == myId(fid)
          && okDate(newData().date)
          && okMs(newData().ts)
          && str(newData().gameId, 40)
          && optStr('gameName', 40) && optStr('domain', 40)
          && optNum('level') && optNum('correct') && optNum('total')
          && optNum('accuracy') && optNum('durationSec') && optNum('roundSec')
          && optBool('inCourse');
      }
      match /sessions/{sid} {
        allow read: if isMember(fid);
        allow create: if isMember(fid) && okId(sid) && validSession();
        allow update: if isMember(fid) && oldData().userId == myId(fid) && validSession();
        allow delete: if isMember(fid) && (oldData().userId == myId(fid) || isAdmin(fid));
      }

      function validAssessment() {
        return newData().keys().hasOnly(['date', 'ts', 'scores', 'total', 'userId'])
          && newData().userId == myId(fid)
          && okDate(newData().date)
          && okMs(newData().ts)
          && newData().scores is map && newData().scores.size() <= 12
          && newData().total is number;
      }
      match /assessments/{aid} {
        allow read: if isMember(fid);
        allow create: if isMember(fid) && okId(aid) && validAssessment();
        allow update: if isMember(fid) && oldData().userId == myId(fid) && validAssessment();
        allow delete: if isMember(fid) && (oldData().userId == myId(fid) || isAdmin(fid));
      }

      // checkins/{YYYY-MM-DD}-{memberId}: one per person per day
      function validCheckin(cid) {
        return newData().keys().hasOnly(['date', 'ts', 'mood', 'sleepHours', 'exercise', 'social', 'meals', 'userId'])
          && newData().userId == myId(fid)
          && okDate(newData().date)
          && cid == newData().date + '-' + myId(fid)
          && okMs(newData().ts)
          && optNum('mood') && optNum('sleepHours')
          && optBool('exercise') && optBool('social') && optBool('meals');
      }
      match /checkins/{cid} {
        allow read: if isMember(fid);
        allow create: if isMember(fid) && validCheckin(cid);
        allow update: if isMember(fid) && oldData().userId == myId(fid) && validCheckin(cid);
        allow delete: if isMember(fid) && (oldData().userId == myId(fid) || isAdmin(fid));
      }

      // ---- 점검 과제 상세 (낱말·점 잇기·숫자 기억 등): 한 번의 월간 점검의 과제별 점수와 세부 수치. 가족만 읽기(훈련하는 분은 쓰기만).
      match /taskRuns/{rid} {
        allow read: if isMember(fid) && isFamilyOnlyReader(fid);
        allow create: if isMember(fid) && okId(rid)
          && newData().keys().hasOnly(['date', 'ts', 'userId', 'v', 'tasks'])
          && newData().userId == myId(fid)
          && okDate(newData().date) && okMs(newData().ts)
          && newData().tasks is map && newData().tasks.size() <= 12;
        allow update: if false;
        allow delete: if isMember(fid) && (resource.data.userId == myId(fid) || isAdmin(fid));
      }

      // ---- 설문 결과 (Short IQCODE, KDSQ-C, SMCQ, GDS-15, PHQ-9, 자체 일상생활 체크 'iadl') : 가족만 읽기
      // 훈련하는 분이 직접 답한 설문도 저장은 되지만(create) 읽을 수는 없어요.
      function validSurvey() {
        return newData().keys().hasOnly(['kind', 'version', 'answers', 'score', 'ts', 'date', 'mode', 'answeredBy', 'subjectId', 'relation'])
          && newData().keys().hasAll(['kind', 'version', 'answers', 'score', 'ts', 'date', 'mode', 'answeredBy', 'subjectId'])
          && newData().kind in ['iqcode', 'kdsq', 'smcq', 'gds', 'phq9', 'iadl']
          && str(newData().version, 10)
          && newData().answers is list && newData().answers.size() <= 30
          && newData().score is number
          && okMs(newData().ts) && okDate(newData().date)
          && newData().mode in ['self', 'family']
          && newData().answeredBy == myId(fid)
          && okId(newData().subjectId) && inT(fid, newData().subjectId)
          && optStr('relation', 20);
      }
      match /surveys/{sid} {
        allow read: if isMember(fid) && isFamilyOnlyReader(fid);
        allow create: if isMember(fid) && okId(sid) && validSurvey();
        allow update: if false;
        allow delete: if isMember(fid) && isFamilyOnlyReader(fid) && (resource.data.answeredBy == myId(fid) || isAdmin(fid));
      }

      // ---- 시계 그림: 훈련하는 분이 그리면 저장(create)되고, 가족만 볼 수 있어요. 자동 채점 없음.
      // img 는 작게 줄인 data URL (PNG/JPEG, 200KB 이하).
      match /clocks/{cid} {
        allow read: if isMember(fid) && isFamilyOnlyReader(fid);
        allow create: if isMember(fid) && okId(cid)
          && newData().keys().hasOnly(['date', 'ts', 'userId', 'img', 'w', 'h'])
          && newData().keys().hasAll(['date', 'ts', 'userId', 'img'])
          && newData().userId == myId(fid)
          && okDate(newData().date) && okMs(newData().ts)
          && newData().img is string && newData().img.size() <= 200000
          // base64 글자만 허용: 따옴표 등이 섞이면 화면의 <img src> 를 깨고 스크립트를 넣을 수 있어요
          && newData().img.matches('^data:image/(png|jpeg);base64,[A-Za-z0-9+/]+=*$')
          && optNum('w') && optNum('h');
        allow update: if false;
        // 그린 사람(훈련하는 분)은 자기 그림을 읽을 수 없으니, 지우는 일은 가족 역할인 사람이 해요.
        allow delete: if isMember(fid) && isFamilyOnlyReader(fid);
      }

      // ---- 수면 기록: checkins 처럼 사람마다 하루 한 개 (문서 id = YYYY-MM-DD-memberId). 가족만 읽기(훈련하는 분은 쓰기만).
      match /sleeplogs/{lid} {
        function validSleep() {
          return newData().keys().hasOnly(['date', 'ts', 'userId', 'bed', 'wake', 'wakings', 'quality'])
            && newData().keys().hasAll(['date', 'ts', 'userId', 'bed', 'wake'])
            && newData().userId == myId(fid)
            && okDate(newData().date) && lid == newData().date + '-' + myId(fid)
            && okMs(newData().ts)
            && okHHMM(newData().bed) && okHHMM(newData().wake)
            && (!('wakings' in newData()) || (newData().wakings is number && newData().wakings >= 0 && newData().wakings <= 20))
            && (!('quality' in newData()) || newData().quality == null || (newData().quality is number && newData().quality >= 1 && newData().quality <= 5));
        }
        allow read: if isMember(fid) && isFamilyOnlyReader(fid);
        allow create: if isMember(fid) && validSleep();
        allow update: if isMember(fid) && oldData().userId == myId(fid) && validSleep();
        allow delete: if isMember(fid) && (oldData().userId == myId(fid) || isAdmin(fid));
      }

      // ---- 병원 검사 기록: 가족이 직접 적은 '점수'만 저장해요 (검사 문항·내용은 없음). 가족 전용: 훈련하는 분은 읽기·쓰기 모두 불가.
      function validClinical() {
        return newData().keys().hasOnly(['test', 'testLabel', 'date', 'score', 'max', 'place', 'result', 'memo', 'recordedBy', 'ts', 'subjectId'])
          && newData().keys().hasAll(['test', 'date', 'recordedBy', 'ts', 'subjectId'])
          && okId(newData().subjectId) && inT(fid, newData().subjectId)
          && newData().test in ['cist', 'mmse_ds', 'k_mmse', 'moca', 'snsb', 'cerad', 'cdr', 'gds_global', 'other']
          && optStr('testLabel', 30) && optStr('place', 40) && optStr('memo', 500)
          && okDate(newData().date) && okMs(newData().ts)
          && newData().recordedBy == myId(fid)
          && optNum('score') && optNum('max')
          && (!('score' in newData()) || newData().score == null || newData().score >= 0)
          && (!('max' in newData()) || newData().max == null || newData().max > 0)
          && (!('score' in newData()) || !('max' in newData()) || newData().score == null || newData().max == null || newData().score <= newData().max)
          && (!('result' in newData()) || newData().result == null || newData().result in ['정상', '인지저하', '경도인지장애', '치매', '기타']);
      }
      match /clinicalTests/{tid} {
        allow read: if isMember(fid) && isFamilyOnlyReader(fid);
        allow create: if isMember(fid) && isFamilyOnlyReader(fid) && okId(tid) && validClinical();
        allow update: if isMember(fid) && isFamilyOnlyReader(fid) && oldData().recordedBy == myId(fid) && validClinical();
        allow delete: if isMember(fid) && isFamilyOnlyReader(fid) && (resource.data.recordedBy == myId(fid) || isAdmin(fid));
      }

      // ---- per-person small docs
      match /reads/{mid} {
        allow read: if isMember(fid);
        allow create, update: if isMember(fid) && mid == myId(fid)
          && newData().keys().hasOnly(['lastReadTs'])
          && newData().lastReadTs is number;
        allow delete: if isMember(fid) && (mid == myId(fid) || isOwner(fid));
      }
      match /reminders/{mid} {
        allow read: if isMember(fid);
        allow create, update: if isMember(fid) && mid == myId(fid)
          && newData().keys().hasOnly(['time', 'enabled'])
          && okHHMM(newData().time)
          && newData().enabled is bool;
        allow delete: if isMember(fid) && (mid == myId(fid) || isOwner(fid));
      }

      // ---- server-managed push bookkeeping (lastAlarmSentDate etc.)
      match /pushState/{mid} {
        allow read: if isMember(fid);
        allow create, update: if false;          // Admin SDK only
        allow delete: if isMember(fid) && isOwner(fid);
      }

      // ---- 훈련하는 분 한 사람씩의 설정 (trainees/{tid}/state/{key}, DESIGN-MULTI §1.2)
      // levels  : 적응 난이도 기록. 그 훈련하는 분의 기기가 판마다 써요 (관리자도 가능).
      // program : 프로그램 시작일. 처음 한 번 그 훈련하는 분이나 관리자가 만들고, 바꾸는 건 관리자.
      // alarm / plan / display : 관리자만 (DESIGN.md §2)
      function validState(key) {
        return (key == 'levels'
                  && newData().keys().hasOnly(['levels', 'updatedTs'])
                  && newData().levels is map && newData().levels.size() <= 40
                  && okMs(newData().updatedTs))
          || (key == 'program'
                  && newData().keys().hasOnly(['startDate'])
                  && okDate(newData().startDate))
          || (key == 'alarm'
                  && newData().keys().hasOnly(['time', 'days', 'updatedBy', 'updatedTs'])
                  && okHHMM(newData().time)
                  && newData().days is list && newData().days.size() <= 7
                  && newData().days.hasOnly([0, 1, 2, 3, 4, 5, 6])
                  && newData().updatedBy == myId(fid)
                  && okMs(newData().updatedTs))
          || (key == 'plan' && validPlan())
          || (key == 'display' && validDisplay());
      }
      // 훈련 계획 (js/program.js normalizePlan/planDoc 와 같은 모양). 게임별 설정(games)은 지도 크기만 확인해요.
      function validPlan() {
        let d = newData();
        let keys = ['v', 'gamesPerDay', 'roundsPerGame', 'targetMin', 'games', 'order', 'fixedOrder', 'weekdays',
                    'checkEveryWeeks', 'checkin', 'showScore', 'updatedBy', 'updatedTs'];
        // autoNextSec(게임 사이 자동 넘김 초)은 나중에 더한 항목이라 없어도 돼요 (앱은 늘 써요)
        return d.keys().hasOnly(keys.concat(['autoNextSec'])) && d.keys().hasAll(keys)
          && (!('autoNextSec' in d) || d.autoNextSec in [0, 5, 10, 15])
          && d.v == 1
          && d.gamesPerDay is int && d.gamesPerDay >= 1 && d.gamesPerDay <= 9
          && (d.roundsPerGame == null || (d.roundsPerGame is int && d.roundsPerGame >= 3 && d.roundsPerGame <= 10))
          && d.targetMin is int && d.targetMin >= 5 && d.targetMin <= 60
          && d.games is map && d.games.size() <= 20
          && d.order in ['rotate', 'fixed']
          && d.fixedOrder is list && d.fixedOrder.size() <= 20
          && d.weekdays is list && d.weekdays.size() >= 1 && d.weekdays.size() <= 7 && d.weekdays.hasOnly([0, 1, 2, 3, 4, 5, 6])
          && d.checkEveryWeeks in [0, 2, 4, 8]
          && d.checkin is bool && d.showScore is bool
          && d.updatedBy == myId(fid)
          && okMs(d.updatedTs);
      }
      // 훈련하는 분 기기의 화면 설정 (관리자가 정하고, 그 기기는 실시간으로 적용)
      function validDisplay() {
        let d = newData();
        let keys = ['v', 'font', 'size', 'contrast', 'voice', 'rate', 'updatedBy', 'updatedTs'];
        return d.keys().hasOnly(keys) && d.keys().hasAll(keys)
          && d.v == 1
          && d.font in ['pretendard', 'noto', 'system']
          && d.size in ['normal', 'large', 'xlarge', 'max']
          && d.contrast is bool && d.voice is bool
          && d.rate is number && d.rate >= 0.5 && d.rate <= 1.5
          && d.updatedBy == myId(fid)
          && okMs(d.updatedTs);
      }

      // ---- 훈련하는 분 목록 state/trainees (state/ 아래 유일한 문서)
      // 관리자: 한 번에 한 명을 끝에 더하거나(그 사람은 같은 배치에서 role 'trainee', 떠나지 않은 사람), 아무나 빼기, 호칭 바꾸기. 최대 4명.
      // 처음 가입: 목록이 아직 없으면 '훈련하는 분' 역할로 막 들어온 사람(1시간 안)이 자기만 넣어 만들 수 있어요.
      function okLbl(d, i) { return d.ids.size() <= i || nonEmpty(d.labels[d.ids[i]], 12); }
      function validTrainees() {
        let d = newData();
        return d.keys().hasOnly(['v', 'ids', 'labels', 'updatedBy', 'updatedTs']) && d.keys().hasAll(['v', 'ids', 'labels', 'updatedBy', 'updatedTs'])
          && d.v == 1 && d.ids is list && d.ids.size() <= 4 && d.ids.toSet().size() == d.ids.size()
          && d.labels is map && d.labels.keys().toSet() == d.ids.toSet()
          && okLbl(d, 0) && okLbl(d, 1) && okLbl(d, 2) && okLbl(d, 3)
          && d.updatedBy == myId(fid) && okMs(d.updatedTs);
      }
      function grantableT(m) {
        return okId(m) && exists(memberPath(fid, m)) && !('leftTs' in get(memberPath(fid, m)).data)
          && getAfter(memberPath(fid, m)).data.role == 'trainee';
      }
      // 한 번에 하나만: 빼기·호칭(목록은 줄거나 같음) 또는 끝에 한 명 더하기 (validAdminsChange 와 같은 방식)
      function tsChange(before) {
        let after = newData().ids;
        return (after.size() <= before.size() && before.hasAll(after))
          || (after.size() == before.size() + 1 && after.hasAll(before)
              && !(after[after.size() - 1] in before) && grantableT(after[after.size() - 1]));
      }
      match /state/trainees {
        allow read: if isMember(fid);
        allow create: if isMember(fid) && validTrainees() && (
             (isAdmin(fid) && tsChange([]))
          || (newData().ids == [myId(fid)] && myMember(fid).role == 'trainee'
              && myMember(fid).joinedTs > request.time - duration.value(1, 'h')));
        allow update: if isMember(fid) && isAdmin(fid) && validTrainees() && tsChange(resource.data.ids);
        allow delete: if false;
      }

      // ---- 훈련하는 분마다의 하위 자료 trainees/{tid}/… (부모 문서는 없어요)
      match /trainees/{tid} {
        function tOK() { return inT(fid, tid); }
        function canWriteT(key, isCreate) {
          return isAdmin(fid) || (key == 'levels' && tid == myId(fid)) || (key == 'program' && isCreate && tid == myId(fid));
        }
        match /state/{key} {
          allow read: if isMember(fid);
          allow create: if isMember(fid) && tOK() && key in ['plan', 'display', 'alarm', 'levels', 'program'] && validState(key) && canWriteT(key, true);
          allow update: if isMember(fid) && tOK() && key in ['plan', 'display', 'alarm', 'levels', 'program'] && validState(key) && canWriteT(key, false);
          allow delete: if isAdmin(fid);
        }
        // 쓸 문항 묶음 (서버가 만들어요): 그 훈련하는 분 본인과 가족 전용 자료를 읽는 사람
        match /aiPacks/{k} {
          allow read: if isMember(fid) && (tid == myId(fid) || isFamilyOnlyReader(fid));
          allow write: if false;
        }
        // plan(서버) / themes(관심사 낱말, 관리자)
        match /aiState/{k} {
          allow read: if isMember(fid);
          allow create, update: if isAdmin(fid) && tOK() && k == 'themes' && validThemes();
          allow delete: if false;
        }
        // 서버가 계산한 숫자·신호·리포트·운영 기록: AI 관리자만 읽어요. 쓰기는 서버만.
        match /aiStats/{k} { allow read: if isAiAdmin(fid); allow write: if false; }
        match /aiSignals/{k} { allow read: if isAiAdmin(fid); allow write: if false; }
        match /aiReports/{k} { allow read: if isAiAdmin(fid); allow write: if false; }
        match /aiOps/{k=**} { allow read: if isAiAdmin(fid); allow write: if false; }
        match /aiNotes/{nid} {
          allow read, delete: if isAiAdmin(fid);
          allow create, update: if isAiAdmin(fid) && okId(nid) && validNote();
        }
      }

      // ---- 오늘 진행 상황 (가족 화면 실시간): progress/{YYYY-MM-DD}-{memberId}
      // 훈련하는 분(T)의 기기가 자기 문서만 게임을 시작할 때와 끝낼 때 써요. js/program.js progressStart/progressFinish 모양.
      match /progress/{pid} {
        function validProgress() {
          let d = newData();
          return d.keys().hasOnly(['userId', 'date', 'v', 'kind', 'planned', 'idx', 'current', 'currentTs',
                                   'results', 'status', 'startTs', 'updatedTs', 'doneTs', 'sts'])
            && d.keys().hasAll(['userId', 'date', 'v', 'kind', 'planned', 'idx', 'results', 'status', 'startTs', 'updatedTs', 'sts'])
            && d.userId == myId(fid)
            && okDate(d.date) && pid == d.date + '-' + myId(fid)
            && d.v == 1
            && d.kind in ['course', 'check']
            && d.planned is list && d.planned.size() <= 13
            && d.idx is int && d.idx >= 0 && d.idx <= 13
            && d.results is list && d.results.size() <= 13
            && d.status in ['started', 'done']
            && (!('current' in d) || d.current == null || str(d.current, 40))
            && (!('currentTs' in d) || d.currentTs == null || okMs(d.currentTs))
            && (!('doneTs' in d) || d.doneTs == null || okMs(d.doneTs))
            && okMs(d.startTs) && okMs(d.updatedTs)
            && d.sts == request.time
            && isAssignedTrainee(fid);
        }
        allow read: if isMember(fid);
        allow create, update: if isMember(fid) && validProgress();
        allow delete: if isMember(fid) && (resource.data.userId == myId(fid) || isAdmin(fid));
      }

      // ---- 마지막으로 본 시간 (하트비트): presence/{memberId}
      // 앱이 열려 있는 동안 60초마다 (규칙은 20초보다 잦은 쓰기를 막아요). lastSeen 은 서버 시간.
      match /presence/{mid} {
        allow read: if isMember(fid);
        allow create, update: if isMember(fid) && mid == myId(fid)
          && newData().keys().hasOnly(['lastSeen', 'ts', 'screen', 'device'])
          && newData().keys().hasAll(['lastSeen', 'ts'])
          && newData().lastSeen == request.time
          && okMs(newData().ts)
          && optStr('screen', 20) && optStr('device', 40)
          && (resource == null || resource.data.lastSeen < request.time - duration.value(20, 's'));
        allow delete: if isMember(fid) && (mid == myId(fid) || isAdmin(fid));
      }

      // ====================================================== AI 문제 은행·리포트 (DESIGN-AI 부록 C)
      // 서버(Cloud Functions, Admin SDK)가 계산하고 쓰는 문서는 클라이언트 쓰기 금지예요.
      // AI 루틴은 Firestore 에 직접 접근하지 않아요(HTTPS 함수 aiRead/aiSubmit 만). 그래서 AI 를 위한 규칙은 없어요.

      // ---- 문항별 기록: 게임 한 판 = 문서 1개. 훈련하는 분(T) 본인의 기기만 만들어요. 배열 안쪽은 크기만 보고 서버가 정리해요.
      function validItemLog() {
        let d = newData();
        return d.keys().hasOnly(['v', 'userId', 'date', 'ts', 'sts', 'gameId', 'inCourse', 'level', 'speechOn', 'size', 'device', 'hour', 'abandoned', 'items'])
          && d.keys().hasAll(['v', 'userId', 'date', 'ts', 'sts', 'gameId', 'items'])
          && d.v == 1
          && d.userId == myId(fid)
          && okDate(d.date) && okMs(d.ts) && d.sts == request.time
          && str(d.gameId, 40)
          && d.items is list && d.items.size() >= 1 && d.items.size() <= 20
          && optBool('inCourse') && optBool('speechOn') && optBool('abandoned')
          && optNum('level') && optNum('hour')
          && optStr('size', 10) && optStr('device', 20);
      }
      match /itemLogs/{sid} {
        allow read: if isMember(fid) && isFamilyOnlyReader(fid);
        allow create: if isMember(fid) && okId(sid) && isAssignedTrainee(fid) && validItemLog();
        allow update: if false;
        allow delete: if isMember(fid) && (resource.data.userId == myId(fid) || isAdmin(fid));
      }

      // ---- AI 상태 (가족 전체): switch(AI 리포트 켜기·끄기, 관리자). 훈련하는 분마다의 plan·themes 는 trainees/{tid}/aiState.
      function okThemeAt(l, i) { return l.size() <= i || (l[i] is string && l[i].size() >= 1 && l[i].size() <= 10); }
      function validThemes() {
        let d = newData();
        return d.keys().hasOnly(['words', 'updatedBy', 'updatedTs']) && d.keys().hasAll(['words', 'updatedBy', 'updatedTs'])
          && d.words is list && d.words.size() <= 8
          && okThemeAt(d.words, 0) && okThemeAt(d.words, 1) && okThemeAt(d.words, 2) && okThemeAt(d.words, 3)
          && okThemeAt(d.words, 4) && okThemeAt(d.words, 5) && okThemeAt(d.words, 6) && okThemeAt(d.words, 7)
          && d.updatedBy == myId(fid) && okMs(d.updatedTs);
      }
      function validSwitch() {
        let d = newData();
        return d.keys().hasOnly(['enabled', 'updatedBy', 'updatedTs']) && d.keys().hasAll(['enabled', 'updatedBy', 'updatedTs'])
          && d.enabled is bool && d.updatedBy == myId(fid) && okMs(d.updatedTs);
      }
      match /aiState/{k} {
        allow read: if isMember(fid);
        allow create, update: if isAdmin(fid) && k == 'switch' && validSwitch();
        allow delete: if false;
      }

      // ---- 가족 전체 운영 기록 (aiOps/bank, aiOps/review, aiOps/wakes 가족 한도): AI 관리자만 읽어요. 쓰기는 서버만.
      match /aiOps/{k=**} {
        allow read: if isAiAdmin(fid);
        allow write: if false;
      }

      // ---- 관리자 메모 모양 (trainees/{tid}/aiNotes): 기간 + 분류 코드 + 자유 글(200자). 자유 글은 AI 에 보내지 않아요(서버는 분류 코드와 날짜만 써요).
      function validNote() {
        let d = newData();
        return d.keys().hasOnly(['from', 'to', 'codes', 'text', 'by', 'ts']) && d.keys().hasAll(['from', 'codes', 'by', 'ts'])
          && okDate(d.from)
          && (!('to' in d) || d.to == null || (okDate(d.to) && d.to >= d.from))
          && d.codes is list && d.codes.size() >= 1 && d.codes.size() <= 9
          && d.codes.hasOnly(['sleep', 'illness', 'med_change', 'hospital', 'event', 'travel', 'device', 'mood', 'other'])
          && optStr('text', 200)
          && d.by == myId(fid) && okMs(d.ts);
      }

      // ---- 관리자의 문항 검토 결정 (옛날 이야기 내보내기, 모호 의심 문항 은퇴·신고). 서버 트리거가 처리해요.
      match /aiReview/{itemId} {
        allow read: if isAdmin(fid);
        allow create: if isAdmin(fid) && itemId.matches('^bk_[0-9a-f]{20}$')
          && newData().keys().hasOnly(['decision', 'note', 'by', 'ts']) && newData().keys().hasAll(['decision', 'by', 'ts'])
          && newData().decision in ['approve', 'retire', 'flag']
          && optStr('note', 100) && newData().by == myId(fid) && okMs(newData().ts);
        allow update, delete: if false;
      }

      // ---- AI 리포트 안내를 본 기록 (consents/{memberId}): 본인만 만들고, 서버 시각. 철회도 기록으로 남겨요.
      function validConsentCreate() {
        let d = newData();
        return d.keys().hasOnly(['kind', 'version', 'ackTs', 'withFamily']) && d.keys().hasAll(['kind', 'version', 'ackTs'])
          && d.kind == 'ai-report-notice' && nonEmpty(d.version, 20) && d.ackTs == request.time && optBool('withFamily');
      }
      // 관리자가 훈련하는 분을 대신해 켜기 ("AI 기록 관찰"): T 에 있는 사람의 문서만, byAdmin = 내 memberId, 서버 시각.
      // 관리자가 훈련하는 분 본인이면(isAiAdmin 이 아니므로) 이 길은 못 써요.
      function validAdminConsentCreate() {
        let d = newData();
        return d.keys().hasOnly(['kind', 'version', 'ackTs', 'withFamily', 'byAdmin']) && d.keys().hasAll(['kind', 'version', 'ackTs', 'byAdmin'])
          && d.kind == 'ai-report-notice' && nonEmpty(d.version, 20) && d.ackTs == request.time && optBool('withFamily')
          && d.byAdmin == myId(fid);
      }
      // 두 모양만: 다시 켜기(버전 + 서버 시각 ackTs, 철회 표시 없음) 또는 끄기(서버 시각 withdrawnTs 만).
      // (철회 표시만 지워 예전 ackTs 로 다시 켜기, 켜기와 끄기를 한 번에 쓰기는 거부)
      function validAdminConsentUpdate() {
        return newData().kind == oldData().kind
          && 'byAdmin' in newData() && newData().byAdmin == myId(fid)
          && ((changed().hasOnly(['version', 'ackTs', 'withdrawnTs', 'byAdmin'])
                && nonEmpty(newData().version, 20) && newData().ackTs == request.time && !('withdrawnTs' in newData()))
           || (changed().hasOnly(['withdrawnTs', 'byAdmin']) && newData().withdrawnTs == request.time));
      }
      match /consents/{mid} {
        allow read: if isMember(fid) && (isAdmin(fid) || mid == myId(fid));
        allow create: if isMember(fid) && (
             (mid == myId(fid) && validConsentCreate())
          || (isAiAdmin(fid) && isCurrentTrainee(fid, mid) && validAdminConsentCreate()));
        allow update: if isMember(fid) && isAiAdmin(fid) && isCurrentTrainee(fid, mid) && validAdminConsentUpdate();
        allow update: if isMember(fid) && mid == myId(fid) && newData().kind == oldData().kind && (
             // 다시 확인 (문구 버전이 바뀌었거나 철회 뒤 다시 동의): 서버 시각, 철회 표시는 지워요
             (changed().hasOnly(['version', 'ackTs', 'withFamily', 'withdrawnTs']) && nonEmpty(newData().version, 20)
                && newData().ackTs == request.time && !('withdrawnTs' in newData()) && optBool('withFamily'))
             // 철회: 서버 시각만 더해요
          || (changed().hasOnly(['withdrawnTs']) && newData().withdrawnTs == request.time));
        allow delete: if false;
      }
    }

    // =========================================== AI: 서버 전용 (Cloud Functions 의 Admin SDK 만)
    // aiConfig(설정·루틴 키 해시), aiInbox(루틴 결과 대기실), aiBank·aiBankIndex·aiRejects(문제 은행),
    // aiAggregates·aiJobs(가명 집계·깨우기 작업, 루틴은 aiRead 함수로만 읽어요), aiRate(한도 계수기), ops(서버 하트비트), tgOutbox(텔레그램 대기열).
    // 구성원·익명·이메일 계정 누구에게도 열지 않아요. (아래 catch-all 과 같지만, 뜻을 분명히 하려고 따로 적어요.)
    match /aiConfig/{d} { allow read, write: if false; }
    match /aiInbox/{d} { allow read, write: if false; }
    match /aiBank/{d} { allow read, write: if false; }
    match /aiBankIndex/{d} { allow read, write: if false; }
    match /aiRejects/{d} { allow read, write: if false; }
    match /aiAggregates/{d} { allow read, write: if false; }
    match /aiJobs/{d} { allow read, write: if false; }
    match /aiRate/{d} { allow read, write: if false; }
    match /ops/{d} { allow read, write: if false; }
    match /tgOutbox/{d} { allow read, write: if false; }   // 텔레그램 대기열 (02:00–08:00 에는 보내지 않고 08:00 에 한 번에)

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
